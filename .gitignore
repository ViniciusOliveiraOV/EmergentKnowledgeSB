# Obsidian per-machine UI state — not knowledge
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/*/data.json
.trash/

# Never commit credentials (see _system/SECURITY.md)
.env
*.key
*.pem
secrets/
_system/local.*

# Python
__pycache__/
*.pyc

# EKSB app config (never inside a workspace)
.ci-eksb-config/

# Python packaging
build/
dist/
*.egg-info/
.venv/
.pytest_cache/
